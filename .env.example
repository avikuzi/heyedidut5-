# Public Vite env (safe to expose to the browser — use the anon key, never the service role)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Committee login: used with the password the ועד types on the gateway.
# Create this Auth user with role=admin (see README).
VITE_ADMIN_EMAIL=avi@heyedidut5.demo

# Local-storage fallback only (when Supabase env is empty). Not used for real Auth.
# VITE_ADMIN_PASSWORD=avi2026

# --- scripts/provision-demo-users.mjs only (do NOT prefix with VITE_) ---
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# DEMO_PASSWORD=Demo2026!

# --- Sprint 2 committee AI (server only — never prefix with VITE_) ---
# Set these on Vercel (and in .env.local for `npm run dev`). Do not commit real keys.
# OPENAI_API_KEY=
# AI_API_KEY=                  # accepted alias if OPENAI_API_KEY is empty
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# Optional server copies. If omitted, the API reuses VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# AI_DRY_RUN=1                 # local/tests only. Unset in production so the real model is called.
